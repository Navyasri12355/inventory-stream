# ── Deployment mode ────────────────────────────────────────────────────────────
# native : PostgreSQL+TimescaleDB and Grafana installed on the host
# docker : run TimescaleDB and Grafana via docker-compose.yml (Kafka stays on host)
DEPLOY_MODE=native

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_HOME=C:\kafka
KAFKA_BOOTSTRAP=localhost:9092,localhost:9094,localhost:9096

# ── Database (TimescaleDB / PostgreSQL) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory
DB_USER=inventory
DB_PASSWORD=inventorydev

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_PORT=3000

# ── Grafana provisioning: resolved differently per DEPLOY_MODE ─────────────────
# native  → absolute path to the repo's grafana/dashboards directory
# docker  → /var/lib/grafana/dashboards  (set by docker-compose.yml; do not change)
GRAFANA_DASHBOARD_PATH=./grafana/dashboards

# ── TimescaleDB connection as seen from Grafana ────────────────────────────────
# native  → localhost / DB_PORT
# docker  → timescaledb / 5432  (set by docker-compose.yml; do not change here)
TSDB_HOST=localhost
TSDB_PORT=5432

# ── Replay / producer ─────────────────────────────────────────────────────────
SPEEDUP=600
TIME_MODE=rebased
TOP_SKUS=500
SEED=42
MAX_GAP_SECONDS=1
WAREHOUSES=WH-01,WH-02,WH-03
WAREHOUSE_STRATEGY=hash

# ── Replenishment / simulator ─────────────────────────────────────────────────
OPENING_DAYS_COVER=30
MIN_OPENING=20
SAFETY_FACTOR=1.2
LEAD_TIME_DAYS_MIN=2
LEAD_TIME_DAYS_MAX=7
TRANSFER_PROB=0.2
ADJUST_RATE=0.002
DAMAGE_RATE=0.001

# ── Fault injection ───────────────────────────────────────────────────────────
DUP_RATE=0.01
LATE_RATE=0.01
MALFORMED_RATE=0.002
BURST_FACTOR=1

# ── Processing windows ────────────────────────────────────────────────────────
# live preset (rebased mode, default)
WINDOW_PRESET=live
WATERMARK_SECONDS=120
TUMBLING_WINDOW_SECONDS=60
SLIDING_WINDOW_SECONDS=300
SLIDE_SECONDS=60
IDLE_FLUSH_SECONDS=30

# EMA decay
EMA_ALPHA=0.3
